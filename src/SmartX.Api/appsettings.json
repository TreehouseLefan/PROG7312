{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5200",
      "http://localhost:8080"
    ]
  },
  "Storage": {
    "UploadsPath": "App_Data/uploads"
  },
  "Simulator": {
    "Enabled": true,
    "AutoEvents": true,
    "AutoEventMinSeconds": 60,
    "AutoEventMaxSeconds": 90,
    "BackfillBatches": 10,
    "BackfillReadingsPerBatch": 30,
    "ApiBaseUrl": ""
  },
  "Pulse": {
    "BaselineWindow": 60,
    "MinimumSamples": 12,
    "ZScoreLimit": 3.0,
    "ConsecutiveBreachesForSpike": 3,
    "AdaptAfterBreaches": 20,
    "SpikeHoldSeconds": 10,
    "HeartbeatWindow": 40,
    "MinStdFractionOfInterval": 0.5,
    "AcceptablePauseFactor": 1.0,
    "FadingPhi": 1.0,
    "OfflinePhi": 8.0,
    "ChatterWindow": 10,
    "ChatterToggleLimit": 6
  },
  "Alerts": {
    "MoistureCriticalBelow": 20,
    "MoistureClearAbove": 22,
    "PowerCriticalAbove": 4000,
    "PowerClearBelow": 3500,
    "OutOfRangeExpirySeconds": 120
  }
}
